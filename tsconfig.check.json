{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/config/*.js",
    "src/shared/subtitle_utils.js",
    "src/shared/stream_planner.js",
    "src/shared/settings.js",
    "src/shared/i18n.js",
    "src/offscreen/opfs_spool.js"
  ]
}
